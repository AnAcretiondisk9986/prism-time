{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "澄镜",
  "mainBinaryName": "prism-time",
  "version": "0.2.0-dev",
  "identifier": "com.prismtime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "澄镜 · 屏幕使用洞察",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
